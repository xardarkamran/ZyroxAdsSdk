<?xml version="1.0" encoding="utf-8"?>
<!-- A dim layer over the screen underneath, with a card in the middle. The spinner is the platform's Material one, an
     animated vector drawable that turns on the render thread, so it keeps spinning while an ad loads on the main thread. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zyrox_dialog_scrim">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/zyrox_dialog_card"
        android:gravity="center"
        android:minWidth="160dp"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/zyroxShowingProgress"
            style="@android:style/Widget.Material.ProgressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/zyrox_ad_cta" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/zyrox_showing_ad"
            android:textColor="@color/zyrox_dialog_text"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
