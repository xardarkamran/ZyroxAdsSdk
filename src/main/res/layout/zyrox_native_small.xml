<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/zyrox_ad_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/zyrox_ad_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/zyrox_ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/zyrox_ad_headline"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/zyrox_ad_cta"
            app:layout_constraintStart_toEndOf="@id/zyrox_ad_icon"
            app:layout_constraintTop_toTopOf="@id/zyrox_ad_icon"
            tools:text="Headline" />

        <TextView
            android:id="@+id/zyrox_ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/zyrox_ad_body"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/zyrox_ad_headline"
            app:layout_constraintStart_toStartOf="@id/zyrox_ad_headline"
            app:layout_constraintTop_toBottomOf="@id/zyrox_ad_headline"
            tools:text="Body" />

        <TextView
            android:id="@+id/zyrox_ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/zyrox_ad_badge"
            android:paddingHorizontal="4dp"
            android:text="@string/zyrox_ad_badge"
            android:textColor="@color/zyrox_ad_badge_text"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/zyrox_ad_body"
            app:layout_constraintTop_toBottomOf="@id/zyrox_ad_body" />

        <RatingBar
            android:id="@+id/zyrox_ad_stars"
            style="@style/ZyroxRatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:isIndicator="true"
            android:numStars="5"
            android:stepSize="0.5"
            app:layout_constraintBottom_toBottomOf="@id/zyrox_ad_badge"
            app:layout_constraintStart_toEndOf="@id/zyrox_ad_badge"
            app:layout_constraintTop_toTopOf="@id/zyrox_ad_badge" />

        <Button
            android:id="@+id/zyrox_ad_cta"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/zyrox_ad_cta"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:minWidth="72dp"
            android:paddingHorizontal="12dp"
            android:textAllCaps="false"
            android:textColor="@color/zyrox_ad_cta_text"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Open" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
